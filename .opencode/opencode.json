{
  "$schema": "https://opencode.ai/config.json",
  "username": "developer",
  "model": "anthropic/claude-sonnet-4-6",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "fullstack-dev",

  "logLevel": "INFO",
  "autoupdate": "notify",

  "skills": {
    "paths": [".opencode/skills"]
  },

  "agent": {
    "fullstack-dev": {
      "description": "Full-stack developer: frontend, backend, database, API design and implementation",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "allow", "bash": { "git *": "allow", "npm *": "allow", "*": "ask" } }
    },
    "code-reviewer": {
      "description": "Code review specialist: code quality checks, bug detection, optimization",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "deny", "read": "allow", "bash": { "git diff *": "allow", "*": "deny" } }
    },
    "devops-engineer": {
      "description": "DevOps engineer: CI/CD, Docker, Kubernetes, cloud infrastructure, monitoring",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "allow", "bash": { "docker *": "allow", "kubectl *": "allow", "*": "ask" } }
    },
    "tdd-developer": {
      "description": "TDD specialist: test writing, refactoring, clean code",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "allow", "bash": { "npm test *": "allow", "*": "ask" } }
    },
    "architect": {
      "description": "Architecture specialist: domain modeling, codebase design, microservices, patterns",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "deny", "read": "allow", "bash": "ask" }
    },
    "security-auditor": {
      "description": "Security audit specialist: OWASP, dependency check, code security review",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "deny", "read": "allow", "bash": "ask" }
    },
    "qa-engineer": {
      "description": "Quality Assurance: test plan, E2E testing, Playwright, integration tests",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "deny", "bash": "ask" }
    },
    "bug-hunter": {
      "description": "Bug diagnosis specialist: reproduction, root cause analysis, fix+test",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "allow", "bash": { "*": "ask" } }
    },
    "designer": {
      "description": "UI/UX designer: frontend design, animation, responsive design, CSS/HTML",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": { "edit": "allow", "bash": "ask" }
    }
  },

  "command": {
    "deploy": {
      "description": "Deploy project (build + deploy)",
      "agent": "devops-engineer",
      "template": "Deploy the project. $ARGUMENTS"
    },
    "test": {
      "description": "Run tests and analyze results",
      "agent": "qa-engineer",
      "template": "Run tests and analyze. $ARGUMENTS"
    },
    "review": {
      "description": "Review code for quality and issues",
      "agent": "code-reviewer",
      "template": "Review the code. $ARGUMENTS"
    },
    "build": {
      "description": "Build the project",
      "template": "Build the project. $ARGUMENTS"
    },
    "fix": {
      "description": "Fix bugs or issues",
      "agent": "bug-hunter",
      "template": "Fix the bug/issue. $ARGUMENTS"
    },
    "arch": {
      "description": "Get architecture advice and guidance",
      "agent": "architect",
      "template": "Provide architecture advice. $ARGUMENTS"
    },
    "design": {
      "description": "Create UI/UX designs",
      "agent": "designer",
      "template": "Create UI/UX design. $ARGUMENTS"
    },
    "security": {
      "description": "Perform security audit",
      "agent": "security-auditor",
      "template": "Perform security audit. $ARGUMENTS"
    },
    "tdd": {
      "description": "Start TDD cycle (test-first development)",
      "agent": "tdd-developer",
      "template": "Start TDD workflow. $ARGUMENTS"
    },
    "debug": {
      "description": "Diagnose and fix bugs",
      "agent": "bug-hunter",
      "template": "Diagnose and fix bugs. $ARGUMENTS"
    },
    "docs": {
      "description": "Create and update documentation",
      "template": "Create or update documentation. $ARGUMENTS"
    },
    "refactor": {
      "description": "Refactor and clean up code",
      "agent": "architect",
      "template": "Refactor the code. $ARGUMENTS"
    },
    "optimize": {
      "description": "Optimize performance and speed",
      "template": "Optimize performance. $ARGUMENTS"
    },
    "analyze": {
      "description": "Perform deep codebase analysis",
      "agent": "architect",
      "template": "Analyze the codebase. $ARGUMENTS"
    },
    "generate": {
      "description": "Generate code and scaffolding",
      "agent": "fullstack-dev",
      "template": "Generate code. $ARGUMENTS"
    },
    "learn": {
      "description": "Learn and analyze the codebase",
      "agent": "architect",
      "template": "Learn and analyze the codebase. $ARGUMENTS"
    },
    "audit": {
      "description": "Run a full security audit",
      "agent": "security-auditor",
      "template": "Run a full security audit. $ARGUMENTS"
    }
  },

  "permission": {
    "edit": "allow",
    "bash": { "git *": "allow", "npm *": "allow", "npx *": "allow", "docker *": "ask", "*": "ask" },
    "read": "allow"
  },

  "provider": {},

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.github.com/mcp",
      "enabled": false,
      "headers": {}
    }
  },

  "references": {
    "docs": {
      "path": "..",
      "description": "Project documentation and codebase"
    }
  },

  "tool_output": {
    "max_lines": 300,
    "max_bytes": 10240
  },

  "experimental": {
    "primary_tools": ["edit", "bash", "read", "glob", "grep", "task"],
    "mcp_timeout": 30000
  }
}
